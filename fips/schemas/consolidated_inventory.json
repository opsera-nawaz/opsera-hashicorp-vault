{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forge.opsera.io/schemas/fips/consolidated_inventory.json",
  "title": "FIPS 140-3 Consolidated Cryptographic Inventory (WO-019 capstone artifact)",
  "description": "Master schema for fips/crypto_inventory.yaml, the single aggregated FIPS 140-3 Phase 1 cryptographic inventory. Produced by fips/scripts/merge_inventory.py from the eight sub-inventory YAML files under fips/inventory/ (WO-005..WO-011) and validated by fips/scripts/validate_consolidated_inventory.sh. Satisfies FIPS-CRYPTO-001, FIPS-DEP-001, and FIPS-CONTAINER-001 quality gates for Phase 2/3/4 consumption.",
  "type": "object",
  "required": [
    "metadata",
    "crypto_call_sites",
    "tls_configurations",
    "crypto_dependencies",
    "container_images",
    "kms_integrations",
    "build_tag_verification",
    "summary",
    "quality_gates",
    "residual_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Generation provenance for this consolidated artifact.",
      "required": [
        "generation_date",
        "source_commit_sha",
        "vault_version",
        "inventory_schema_version",
        "source_inventories"
      ],
      "properties": {
        "generation_date": {
          "type": "string",
          "description": "UTC timestamp (ISO 8601) when fips/crypto_inventory.yaml was generated."
        },
        "source_commit_sha": {
          "type": "string",
          "description": "Output of `git rev-parse HEAD` at generation time, or 'unknown' if it could not be determined (e.g. running outside a git repository)."
        },
        "vault_version": {
          "type": "string",
          "description": "Vault version string sourced from version/VERSION (as consumed by version/version.go's embedded fullVersion)."
        },
        "inventory_schema_version": {
          "type": "string",
          "description": "Semantic version of this consolidated inventory's own structure, independent of the four per-call-site sub-schemas it aggregates."
        },
        "source_inventories": {
          "type": "array",
          "minItems": 8,
          "description": "Every fips/inventory/*.yaml file consumed by the merge, tagged with the work order that produced it.",
          "items": {
            "type": "object",
            "required": ["file", "work_order"],
            "properties": {
              "file": { "type": "string" },
              "work_order": { "type": "string" }
            }
          }
        }
      }
    },
    "crypto_call_sites": {
      "type": "array",
      "description": "Merged call-site entries from keysutil_policy_crypto_sites.yaml (WO-005), core_barrier_seal_crypto_sites.yaml (WO-006), builtin_logical_crypto_sites.yaml (WO-007), and builtin_credential_crypto_sites.yaml (WO-007). Each entry keeps every field from its original per-work-order schema plus provenance tags; the four source schemas differ (crypto_inventory_entry.json, core_barrier_seal_entry.json, builtin_engine_crypto_entry.json) so this array intentionally does not force a single narrow item shape beyond the common provenance/classification fields below.",
      "items": {
        "type": "object",
        "required": ["source_file", "source_work_order", "file", "algorithm", "library", "security_relevant", "fips_approved"],
        "properties": {
          "source_file": { "type": "string", "description": "fips/inventory/<name>.yaml this entry was copied from." },
          "source_work_order": { "type": "string" },
          "file": { "type": "string" },
          "algorithm": { "type": "string" },
          "library": { "type": "string" },
          "security_relevant": { "type": "boolean" },
          "fips_approved": { "type": "boolean" },
          "enterprise_only": { "type": "boolean" },
          "module_boundary": {
            "type": "string",
            "enum": ["barrier-internal", "seal-external-kms", "seal-shamir", "core-orchestration"]
          }
        }
      }
    },
    "tls_configurations": {
      "type": "array",
      "description": "TLS listener/client configuration entries from tls_listener_config.yaml (WO-008), tagged with provenance.",
      "items": {
        "type": "object",
        "required": ["source_file", "source_work_order", "file", "component", "config_parameter"],
        "properties": {
          "source_file": { "type": "string" },
          "source_work_order": { "type": "string" },
          "file": { "type": "string" },
          "component": { "type": "string" },
          "config_parameter": { "type": "string" }
        }
      }
    },
    "crypto_dependencies": {
      "type": "object",
      "description": "Module-level dependency entries from crypto_dependencies.yaml (WO-009).",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_file", "source_work_order", "module_path", "version", "direct_or_transitive"],
            "properties": {
              "source_file": { "type": "string" },
              "source_work_order": { "type": "string" },
              "module_path": { "type": "string" },
              "version": { "type": "string" },
              "direct_or_transitive": { "type": "string", "enum": ["direct", "transitive"] }
            }
          }
        },
        "excluded_graph_only_nodes": {},
        "pkcs11_boundary_confirmation": {}
      }
    },
    "container_images": {
      "type": "object",
      "description": "Deployment-path container image entries from container_kms_inventory.yaml (WO-010).",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_file", "source_work_order", "id", "base_image"],
            "properties": {
              "source_file": { "type": "string" },
              "source_work_order": { "type": "string" },
              "id": { "type": "string" },
              "base_image": { "type": "string" }
            }
          }
        },
        "enterprise_only_fips_images": {}
      }
    },
    "kms_integrations": {
      "type": "object",
      "description": "External KMS/HSM seal integration entries from container_kms_inventory.yaml (WO-010).",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_file", "source_work_order", "provider", "go_wrapper_module"],
            "properties": {
              "source_file": { "type": "string" },
              "source_work_order": { "type": "string" },
              "provider": { "type": "string" },
              "go_wrapper_module": { "type": "string" }
            }
          }
        },
        "non_kms_seals": {},
        "validation": {}
      }
    },
    "build_tag_verification": {
      "type": "object",
      "description": "Full CE FIPS build-tag verification record from ce_fips_build_tag_verification.yaml (WO-011).",
      "required": ["source_file", "source_work_order", "verification_id", "verification_result"],
      "properties": {
        "source_file": { "type": "string" },
        "source_work_order": { "type": "string" },
        "verification_id": { "type": "string" },
        "verification_result": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "description": "Computed statistics over crypto_call_sites. Must be recomputed on every merge, never hardcoded or cached.",
      "required": [
        "total_crypto_call_sites",
        "fips_approved_count",
        "non_approved_count",
        "security_relevant_count",
        "non_security_relevant_count",
        "enterprise_only_count",
        "by_module_boundary"
      ],
      "properties": {
        "total_crypto_call_sites": { "type": "integer", "minimum": 0 },
        "fips_approved_count": { "type": "integer", "minimum": 0 },
        "non_approved_count": { "type": "integer", "minimum": 0 },
        "security_relevant_count": { "type": "integer", "minimum": 0 },
        "non_security_relevant_count": { "type": "integer", "minimum": 0 },
        "enterprise_only_count": { "type": "integer", "minimum": 0 },
        "by_module_boundary": {
          "type": "object",
          "required": ["barrier-internal", "seal-external-kms", "seal-shamir", "core-orchestration"],
          "properties": {
            "barrier-internal": { "type": "integer", "minimum": 0 },
            "seal-external-kms": { "type": "integer", "minimum": 0 },
            "seal-shamir": { "type": "integer", "minimum": 0 },
            "core-orchestration": { "type": "integer", "minimum": 0 }
          }
        },
        "entries_without_module_boundary_classification": { "type": "integer", "minimum": 0 }
      }
    },
    "quality_gates": {
      "type": "object",
      "description": "PASS/PARTIAL/FAIL/BLOCKED status for each Phase 1 quality gate, with evidence pointing at specific sections of this same artifact. Never rounds up to PASS when only some entries in a category are complete.",
      "required": ["FIPS-CRYPTO-001", "FIPS-DEP-001", "FIPS-CONTAINER-001"],
      "properties": {
        "FIPS-CRYPTO-001": {
          "type": "object",
          "required": ["name", "status", "evidence"],
          "properties": {
            "name": { "type": "string" },
            "status": { "type": "string", "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"] },
            "evidence": { "type": "string" }
          }
        },
        "FIPS-DEP-001": {
          "type": "object",
          "required": ["name", "status", "evidence"],
          "properties": {
            "name": { "type": "string" },
            "status": { "type": "string", "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"] },
            "evidence": { "type": "string" }
          }
        },
        "FIPS-CONTAINER-001": {
          "type": "object",
          "required": ["name", "status", "evidence"],
          "properties": {
            "name": { "type": "string" },
            "status": { "type": "string", "enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED"] },
            "evidence": { "type": "string" }
          }
        }
      }
    },
    "residual_gaps": {
      "type": "array",
      "minItems": 7,
      "description": "Known FIPS-alignment gaps requiring Phase 2/3 remediation, each backed by evidence references into the sub-inventory sections above.",
      "items": {
        "type": "object",
        "required": ["id", "title", "phase", "evidence", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "phase": { "type": "string" },
          "evidence": { "type": "array", "minItems": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
